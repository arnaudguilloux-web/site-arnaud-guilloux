  "testimonials": [
    {
      "highlight_fr": "1er IRONMAN 70.3",
      "highlight_en": "First IRONMAN 70.3",
      "context_fr": "Nice · 2021",
      "context_en": "Nice · 2021",
      "quote": "Parti de zéro en natation et à vélo avec un seul semi-marathon en poche, son coaching exigeant mais toujours à l'écoute m'a apporté la rigueur et le soutien moral nécessaires pour franchir des caps que je pensais impossibles",
      "name": "Antonio",
      "city": "Plouarzel",
      "url": "https://triathlon-lab.app/athletes/490855"
    },
    {
      "highlight_fr": "9h06",
      "highlight_en": "9:06",
      "context_fr": "IRONMAN Texas · billet pour Kona",
      "context_en": "IRONMAN Texas · Kona slot",
      "quote": "Pas besoin d'être \"déjà assez bon\" pour se faire coacher : c'est justement pour progresser qu'on y va. Arnaud est exigeant mais jamais dans l'excès, et il te dit les choses franchement.",
      "name": "Martin",
      "city": "Paris",
      "url": "https://triathlon-lab.app/athletes/298448"
    },
    {
      "highlight_fr": "2h16 à vélo",
      "highlight_en": "2:16 on the bike",
      "context_fr": "IRONMAN 70.3 Málaga",
      "context_en": "IRONMAN 70.3 Málaga",
      "quote": "Arnaud saura t'accompagner et jongler avec tes différentes contraintes tout en te faisant progresser.",
      "name": "Guillaume",
      "city": "",
      "url": "https://triathlon-lab.app/athletes/739987"
    },
    {
      "highlight_fr": "15e",
      "highlight_en": "15th",
      "context_fr": "Groupe d'âge · Championnat du monde, Kona 2026",
      "context_en": "Age group · World Championship, Kona 2026",
      "quote": "Une meilleure planification de la charge, une optimisation des zones de travail, une amélioration des points faibles, un ajustement en temps réel des imprévus",
      "name": "Phil",
      "city": "Toulouse",
      "url": "https://triathlon-lab.app/athletes/51556"
    },
    {
      "highlight_fr": "Stage en Bretagne",
      "highlight_en": "Camp in Brittany",
      "context_fr": "Tests physiologiques et bike fit",
      "context_en": "Physiological testing and bike fit",
      "quote": "Arnaud a une vraie expertise de l'Ironman, notamment dans sa capacité à reproduire les conditions de fatigue propres à cette discipline et à travailler la durabilité.",
      "name": "Louis",
      "city": "Paris",
      "url": "https://triathlon-lab.app/athletes/878790"
    },
    {
      "highlight_fr": "Objectif marathon",
      "highlight_en": "Marathon goal",
      "context_fr": "Temps visé atteint",
      "context_en": "Target time reached",
      "quote": "Avant tout, une vraie tranquillité d'esprit ! Je n'ai plus à me demander quoi faire ni comment organiser mes entraînements. Je prends ma montre et c'est parti !",
      "name": "Mohamed",
      "city": "Casablanca"
    },
    {
      "highlight_fr": "5 km en 19'24",
      "highlight_en": "5K in 19:24",
      "context_fr": "Nouveau record · mai 2025",
      "context_en": "New PB · May 2025",
      "quote": "Le coaching m'a apporté rigueur, fierté, partage et rencontres.",
      "name": "Alexis",
      "city": "Brest"
    },
    {
      "highlight_fr": "À nouveau coaché",
      "highlight_en": "Back with Arnaud",
      "context_fr": "Ami d'abord, athlète ensuite",
      "context_en": "A friend first, then an athlete",
      "quote": "Arnaud était un ami avant d'être mon coach, il n'était plus mon coach mais toujours mon ami et il est à nouveau mon coach et toujours mon ami... Bref tu veux performer sans te prendre la tête alors t'es au bon endroit !",
      "name": "Pierre",
      "city": "Brest",
      "url": "https://triathlon-lab.app/athletes/397176"
    },
    {
      "highlight_fr": "",
      "highlight_en": "",
      "context_fr": "",
      "context_en": "",
      "quote": "Arnaud est un expert sur la manière et la méthode à te faire progresser pour être performant sans oublier que le plaisir doit être aussi présent.",
