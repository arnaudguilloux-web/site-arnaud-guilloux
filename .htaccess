Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On

# Forcer HTTPS : décommenter une fois le certificat SSL activé dans le manager OVH.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Version anglaise : /en/
RewriteRule ^en/?$ index.php?lang=en [L,QSA]

# Fichiers internes non servis
<FilesMatch "^(lib\.php|README\.md|CLAUDE\.md|STATUS\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
</IfModule>
