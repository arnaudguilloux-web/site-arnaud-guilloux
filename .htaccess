Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On

# Adresse unique du site : https://www.arnaudguilloux.fr
# (les règles ne visent que ce domaine : sans effet en local ou sur une autre adresse).
# 1. Sans « www » : redirection directe vers https://www.
RewriteCond %{HTTP_HOST} ^arnaudguilloux\.fr$ [NC]
RewriteRule ^ https://www.arnaudguilloux.fr%{REQUEST_URI} [L,R=301]
# 2. Avec « www » mais en http : redirection vers https.
RewriteCond %{HTTP_HOST} ^www\.arnaudguilloux\.fr$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.arnaudguilloux.fr%{REQUEST_URI} [L,R=301]

# Version anglaise : /en/
RewriteRule ^en/?$ index.php?lang=en [L,QSA]

# Fichiers internes non servis
<FilesMatch "^(lib\.php|README\.md|CLAUDE\.md|STATUS\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
</IfModule>
